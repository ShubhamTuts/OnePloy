APP_ID=
APP_NAME=OnePloy
APP_ENV=production
APP_KEY=
APP_URL=
APP_PORT=8000

ONEPLOY_VERSION=latest
ONEPLOY_REALTIME_VERSION=latest
ONEPLOY_HELPER_VERSION=latest
ONEPLOY_REGISTRY=ghcr.io/shubhamtuts
ONEPLOY_RELEASE_CHANNEL=stable
ONEPLOY_RELEASE_MANIFEST_URL=https://raw.githubusercontent.com/ShubhamTuts/OnePloy/main/releases/stable.json
ONEPLOY_SOURCE_REF=main
ONEPLOY_SUPPORT_EMAIL=
ONEPLOY_SUPPORT_URL=https://github.com/ShubhamTuts/OnePloy/issues
ONEPLOY_PUBLIC_IPV4=
ONEPLOY_PUBLIC_IPV6=
ONEPLOY_PRIVATE_IP=
BASE_CONFIG_PATH=/data/oneploy

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=oneploy
DB_USERNAME=oneploy
DB_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
SOKETI_PORT=6001
SOKETI_TERMINAL_PORT=6002

ROOT_USERNAME=
ROOT_USER_EMAIL=
ROOT_USER_PASSWORD=

# Optional outbound email configuration is managed from the OnePloy admin UI.
# Provider credentials must not be committed to source control.

# Compatibility only. New OnePloy code should use ONEPLOY_* variables.
REGISTRY_URL=ghcr.io
AUTOUPDATE=false
